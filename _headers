# =====================================================================
# RENUEVA — _headers
# Cabeceras de seguridad y caché. Funciona AUTOMÁTICAMENTE en Cloudflare Pages
# y en Netlify (basta con subir este archivo junto con index.html, en la raíz).
# NO funciona en GitHub Pages (no permite cabeceras personalizadas).
# Cada línea que empieza con dos espacios es una cabecera que se aplica a las
# rutas indicadas arriba de ella.
# =====================================================================

/*
  # Política de Seguridad de Contenido: solo recursos propios, envío del formulario (FormSubmit/Formspree)
  # y el mapa de Google Maps (frame-src).
  # frame-ancestors 'none' impide que otra web meta tu página en un <iframe> (clickjacking).
  # EDITAR AQUÍ: si cambias de servicio de formularios, cambia el dominio en connect-src.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://formsubmit.co https://formspree.io; frame-src https://www.google.com; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  # Obliga a usar HTTPS durante 1 año (los navegadores recordarán no usar HTTP).
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Impide que el navegador "adivine" tipos de archivo (evita ejecutar archivos disfrazados).
  X-Content-Type-Options: nosniff
  # Refuerzo contra clickjacking para navegadores antiguos.
  X-Frame-Options: DENY
  # Limita la información de origen que se envía al hacer clic en enlaces externos.
  Referrer-Policy: strict-origin-when-cross-origin
  # Desactiva funciones del navegador que esta web no usa.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  # Aísla esta página de otras ventanas (protege contra ataques entre pestañas).
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Caché: CSS y JS se revisan a diario (así tus cambios se ven pronto);
# imágenes e iconos se guardan una semana para que la web cargue más rápido.
/css/*
  Cache-Control: public, max-age=86400, must-revalidate
/js/*
  Cache-Control: public, max-age=86400, must-revalidate
/assets/*
  Cache-Control: public, max-age=604800
